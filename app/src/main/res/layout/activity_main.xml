<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/theme_low_bg"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Top App Title & Subtitle -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="🎮 Sensor Playground"
            android:textColor="@color/theme_low_text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Eksplorasi sensor smartphone dengan permainan interaktif!"
            android:textColor="@color/theme_low_text_secondary"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <!-- Sensor Status Badges -->
        <LinearLayout
            android:id="@+id/llBadges"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

            <TextView
                android:id="@+id/tvMotionBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_badge_active"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="🎯 Motion: Aktif"
                android:textColor="@color/badge_active_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLightBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_active"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="☀️ Light: Aktif"
                android:textColor="@color/badge_active_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- SEPARATOR TOGGLE BUTTONS (Pemisah Sensor Kemiringan vs Sensor Cahaya) -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleSensorSelector"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:checkedButton="@id/btnTabMotion"
            app:selectionRequired="true"
            app:singleSelection="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llBadges">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabMotion"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🧭 Kemiringan"
                android:textSize="13sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_gyro" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabLight"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="☀️ Cahaya"
                android:textSize="13sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_sun" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- ======================================================== -->
        <!-- SECTION 1: SENSOR KEMIRINGAN (MOTION & ARCADE GAME)      -->
        <!-- ======================================================== -->
        <LinearLayout
            android:id="@+id/layoutMotionSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="visible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toggleSensorSelector">

            <!-- Arcade Scoreboard HUD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvHudCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/theme_low_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/theme_low_card_stroke"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:weightSum="4">

                    <!-- Score -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🏆 SKOR"
                            android:textColor="@color/theme_low_text_secondary"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHudScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/game_gold"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- High Score -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="👑 REKOR"
                            android:textColor="@color/theme_low_text_secondary"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHudHighScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/theme_low_text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Level -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.8"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⭐ LEVEL"
                            android:textColor="@color/theme_low_text_secondary"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHudLevel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lv.1"
                            android:textColor="@color/game_level_purple"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Combo -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.9"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="COMBO"
                            android:textColor="@color/theme_low_text_secondary"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHudCombo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="x1"
                            android:textColor="@color/game_combo"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Mode Selection Chips -->
            <HorizontalScrollView
                android:id="@+id/hsvModes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupModes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipStarCatcher"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/mode_star_catcher" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBubblePop"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mode_bubble_pop" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPhysicsLab"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mode_physics_lab" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Interactive Ball Simulation Arena Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvSimulationCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/theme_low_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/theme_low_card_stroke"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvSimTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🕹️ Arena Permainan"
                            android:textColor="@color/theme_low_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSkin"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="@string/btn_change_skin"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.example.sensorplayground.BallSimulationView
                        android:id="@+id/ballSimulationView"
                        android:layout_width="match_parent"
                        android:layout_height="250dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_simulation" />

                    <!-- Action Controls -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCalibrate"
                            style="@style/Widget.Material3.Button.Icon"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/theme_low_accent"
                            android:text="@string/btn_calibrate"
                            android:textColor="@color/theme_low_bg"
                            android:textSize="12sp"
                            app:icon="@drawable/ic_calibrate"
                            app:iconTint="@color/theme_low_bg" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReset"
                            style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="@string/btn_reset"
                            android:textColor="@color/theme_low_text_primary"
                            android:textSize="12sp"
                            app:icon="@drawable/ic_reset"
                            app:iconTint="@color/theme_low_text_primary"
                            app:strokeColor="@color/theme_low_card_stroke" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Cockpit Radar Kemiringan Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvMotionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/theme_low_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/theme_low_card_stroke"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvMotionTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/tilt_radar_title"
                            android:textColor="@color/theme_low_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvMotionStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🟢 Stabil"
                            android:textColor="@color/theme_low_accent"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Custom Visual Tilt Radar Spirit Bubble -->
                        <com.example.sensorplayground.TiltRadarView
                            android:id="@+id/tiltRadarView"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:layout_marginEnd="14dp" />

                        <!-- Live Physics Metrics -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvSpeed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Kecepatan Bola: 0 px/s"
                                android:textColor="@color/theme_low_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvGForce"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="G-Force: 1.00 g"
                                android:textColor="@color/theme_low_text_secondary"
                                android:textSize="12sp" />

                            <!-- Raw XYZ values -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvValX"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="X: 0.00 m/s²"
                                    android:textColor="@color/theme_low_text_secondary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvValY"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Y: 0.00 m/s²"
                                    android:textColor="@color/theme_low_text_secondary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvValZ"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Z: 9.81 m/s²"
                                    android:textColor="@color/theme_low_text_secondary"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- ======================================================== -->
        <!-- SECTION 2: SENSOR CAHAYA (LIGHT & CELESTIAL MASCOT)      -->
        <!-- ======================================================== -->
        <LinearLayout
            android:id="@+id/layoutLightSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toggleSensorSelector">

            <!-- Interactive Mascot & Solar Ring Dial Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvLightMascotCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/theme_low_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/theme_low_card_stroke"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvLightMascotTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✨ Maskot Cuaca &amp; Energi Cahaya"
                        android:textColor="@color/theme_low_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Custom Interactive Celestial Sun/Moon Mascot -->
                    <com.example.sensorplayground.LightVisualizerView
                        android:id="@+id/lightVisualizerView"
                        android:layout_width="220dp"
                        android:layout_height="220dp"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="💡 Ketuk maskot untuk letupan cahaya!"
                        android:textColor="@color/theme_low_text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Real-time Lux Readings Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvLightMeterCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/theme_low_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/theme_low_card_stroke"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvLightTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Intensitas Cahaya (Lux)"
                            android:textColor="@color/theme_low_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPeakLux"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Puncak: 0.0 Lux"
                            android:textColor="@color/game_gold"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvValLux"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0.0 Lux"
                            android:textColor="@color/theme_low_accent"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvLightCondition"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_active"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:text="@string/light_condition_low"
                            android:textColor="@color/badge_active_text"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvLuxDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/light_perk_low"
                        android:textColor="@color/theme_low_text_secondary"
                        android:textSize="12sp" />

                    <!-- Light Gauge Indicator -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/pbLightLevel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:max="1000"
                        android:progress="50"
                        app:indicatorColor="@color/theme_low_accent"
                        app:trackColor="@color/theme_low_card_stroke"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="8dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Interactive Light Quests / Challenges Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvLightQuestsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/theme_low_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/theme_low_card_stroke"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvQuestTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎯 Tantangan Eksplorasi Cahaya"
                        android:textColor="@color/theme_low_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- Quest 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🌑 Tutup sensor dengan tangan (&lt; 15 Lux)"
                            android:textColor="@color/theme_low_text_primary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvQuestDark"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
